# Docker Deployment Configuration
APP_PORT=8080
TZ=Asia/Shanghai
APP_IMAGE=ghcr.io/ur-xiaoyang/asset-management-system:latest

# Database: sqlite, mysql, or postgres
DB_TYPE=sqlite

# CORS origins, comma separated. Add your domain when deploying publicly.
# Example: ALLOWED_ORIGINS=https://assets.example.com,http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080

# Initial administrator. Only used when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=系统管理员

# MySQL Configuration, used when DB_TYPE=mysql
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_DATABASE=lab_asset
MYSQL_USER=lab_asset
MYSQL_PASSWORD=change_this_mysql_password

# PostgreSQL Configuration, used when DB_TYPE=postgres
POSTGRES_DB=lab_asset
POSTGRES_USER=lab_asset
POSTGRES_PASSWORD=change_this_postgres_password

# SMTP Email Configuration (optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_ENABLED=false
SMTP_SECURE=false
